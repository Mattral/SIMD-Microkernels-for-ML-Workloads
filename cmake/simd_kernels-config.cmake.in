# simd_kernels-config.cmake — CMake package config for IntrinsicML
#
# Downstream usage:
#   find_package(simd_kernels REQUIRED)
#   target_link_libraries(my_target PRIVATE simd_kernels::simd_kernels)

@PACKAGE_INIT@

# Import the exported targets (simd_kernels::simd_kernels_lib)
include("${CMAKE_CURRENT_LIST_DIR}/simd_kernels-targets.cmake")

# Create the canonical alias: simd_kernels::simd_kernels
# so users can write target_link_libraries(... simd_kernels::simd_kernels)
# rather than the internal _lib-suffixed name.
if(TARGET simd_kernels::simd_kernels_lib AND NOT TARGET simd_kernels::simd_kernels)
    add_library(simd_kernels::simd_kernels ALIAS simd_kernels::simd_kernels_lib)
endif()

# Convenience variable for consumers that prefer variables over targets
get_target_property(_simd_inc simd_kernels::simd_kernels_lib
    INTERFACE_INCLUDE_DIRECTORIES)
set(SIMD_KERNELS_INCLUDE_DIRS "${_simd_inc}")
set(SIMD_KERNELS_VERSION "@PROJECT_VERSION@")
set(SIMD_KERNELS_FOUND TRUE)

check_required_components(simd_kernels)
